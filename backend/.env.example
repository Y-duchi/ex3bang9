# Copy to .env.local. Never commit .env.local.
DJANGO_SECRET_KEY=replace-with-a-local-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=bang9_db
DB_USER=bang9
DB_PASSWORD=replace-with-local-db-password
DB_ROOT_PASSWORD=replace-with-local-root-password
DB_HOST=127.0.0.1
DB_PORT=3307

# Portfolio demo uses the console backend and sends no real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Native Flutter clients do not require permissive browser CORS.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=
